    {
      "name": "1. santi (acceso TOTAL - 4 tools)",
      "description": "Auto-login como santi (pre-request script del folder). santi tiene TODAS las tools.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const username = 'santi';",
              "const cached = pm.collectionVariables.get('token_' + username);",
              "const ts = Number(pm.collectionVariables.get('token_' + username + '_ts') || 0);",
              "if (cached && (Date.now() - ts) < 6 * 60 * 60 * 1000) {",
              "    pm.collectionVariables.set('access_token', cached);",
              "    pm.collectionVariables.set('current_user', username);",
              "    console.log('[FGAC] Reusando token cacheado de ' + username);",
              "} else {",
              "    console.log('[FGAC] Login automatico como ' + username + '...');",
              "    pm.sendRequest({",
              "        url: pm.collectionVariables.get('cognito_endpoint'),",
              "        method: 'POST',",
              "        header: {",
              "            'Content-Type': 'application/x-amz-json-1.1',",
              "            'X-Amz-Target': 'AWSCognitoIdentityProviderService.InitiateAuth'",
              "        },",
              "        body: { mode: 'raw', raw: JSON.stringify({",
              "            AuthFlow: 'USER_PASSWORD_AUTH',",
              "            ClientId: pm.collectionVariables.get('client_id'),",
              "            AuthParameters: { USERNAME: username, PASSWORD: pm.collectionVariables.get('password') }",
              "        })}",
              "    }, (err, res) => {",
              "        if (err) { console.error('[FGAC] Error de login:', err); return; }",
              "        const token = res.json().AuthenticationResult?.AccessToken;",
              "        if (!token) { console.error('[FGAC] Sin AccessToken:', res.text()); return; }",
              "        pm.collectionVariables.set('token_' + username, token);",
              "        pm.collectionVariables.set('token_' + username + '_ts', String(Date.now()));",
              "        pm.collectionVariables.set('access_token', token);",
              "        pm.collectionVariables.set('current_user', username);",
              "        console.log('[FGAC] Token de ' + username + ' obtenido y activado');",
              "    });",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "tools/list (espera 4 tools)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function parseMcp() {",
                  "    let text = pm.response.text();",
                  "    if (text.includes('data:')) {",
                  "        const line = text.split(/\\r?\\n/).find(l => l.startsWith('data:'));",
                  "        if (line) text = line.slice(5).trim();",
                  "    }",
                  "    return JSON.parse(text);",
                  "}",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = parseMcp();",
                  "const tools = (body.result?.tools || []).map(t => t.name.split('___').pop()).sort();",
                  "console.log('[FGAC] Tools visibles para santi:', tools);",
                  "pm.test('santi VE exactamente 4 tools', () => pm.expect(tools).to.have.lengthOf(4));",
                  "pm.test('santi ve TODAS las tools esperadas', () => {",
                  "    pm.expect(tools).to.eql(['consulta_canales','consulta_preferencias','consulta_saldo','consulta_tarjetas']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json, text/event-stream" }
            ],
            "url": { "raw": "{{mcp_url}}", "host": ["{{mcp_url}}"] },
            "body": {
              "mode": "raw",
              "raw": "{ \"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/list\", \"params\": {} }"
            }
          }
        },
